<!--div class="center jumbotron"-->
<%# Prefer the users.new locale text. That way, translators don't need to
    translate more than once, and in addition we'll use consistent terms. %>
 <br>
 <h1 class="center"><%= t('.update_user_info') %></h1>

 <div class="row">
   <div class="col-md-6 col-md-offset-3">
     <%= form_for(@user) do |f| %>
       <%# return_to must be this page's own GET URL (edit_user_path), not
           user_path (what form_for(@user) posts to, and what request.
           original_fullpath would default return_to to on a failed
           PATCH): the default would otherwise send a forced-login-mid-
           edit back to the read-only show page instead of back to this
           form. See docs/login-session-simplify.md Part 2 step 1. %>
       <%= hidden_field_tag :return_to, edit_user_path(@user) %>
       <%= pending_resubmission_token_field %>
       <%= render 'shared/error_messages', object: f.object %>
       <%= f.label :name, t('users.new.name') %>
       <%= f.text_field :name, class:"form-control" %>

       <%= f.label :email, t('users.new.email') %>
       <%= f.email_field :email, class:"form-control" %>

       <%= f.label :preferred_locale, t('users.new.preferred_locale') %>
       <%= f.select :preferred_locale,
                    Rails.application.config.locale_select_options[I18n.locale.to_s],
                    {}, {class: "form-control"} %>

       <%= f.label :notification_emails, t('users.edit.notification_emails') %>
       <%= f.check_box :notification_emails, class: "form-check-input" %>
       <small class="form-text text-muted"><%= t('users.edit.notification_emails_help') %></small>

       <%= f.label :important_notifications, t('users.edit.important_notifications') %>
       <%= f.check_box :important_notifications, class: "form-check-input" %>
       <small class="form-text text-muted"><%= t('users.edit.important_notifications_help') %></small>

       <% if @user.provider == 'local' %>
         <%= f.label :password, t('users.new.password') %>
         <%= f.password_field :password, autocomplete: "off", class:"form-control" %>

         <%= f.label :password_confirmation, t('users.new.password_confirmation') %>
         <%= f.password_field :password_confirmation, autocomplete: "off", class:"form-control" %>
       <% end %>

       <%= f.submit t('.save_changes'), class: "btn btn-primary" %>
     <% end %>
   </div>
 </div>

</div>
